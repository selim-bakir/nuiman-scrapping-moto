# Token du bot Telegram (créé via @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat ID de Nuiman (destinataire du rapport).
# Pour le récupérer : démarrer une conversation avec le bot, puis
# https://api.telegram.org/bot<TOKEN>/getUpdates → champ "chat":{"id":...}
TELEGRAM_CHAT_ID=123456789

# Optionnel : nombre de scrapers exécutés en parallèle (défaut 3)
SCRAPE_CONCURRENCY=3

# Optionnel : timeout de chargement de page en millisecondes (défaut 30000)
PAGE_TIMEOUT_MS=30000
